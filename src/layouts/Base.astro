---
import { Font } from "astro:assets";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import Seo from "@/components/layout/Seo.astro";
import { site } from "@/data/site";
import { getScriptHash } from "@/lib/csp";
import navigationScript from "@/scripts/navigation.js?raw";
import themeScript from "@/scripts/theme.js?raw";
import "@/styles/global.css";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;

for (const script of [themeScript, navigationScript]) {
    Astro.csp?.insertScriptHash(getScriptHash(script));
}
Astro.csp?.insertScriptResource("'self'");
---

<!doctype html>
<html lang={site.lang} dir="ltr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <script is:inline set:html={themeScript}/>
    <Seo title={title} description={description}/>
    <Font cssVariable="--font-signika" preload/>
    <Font cssVariable="--font-heebo" preload/>
</head>
<body>
<a class="skip-link print-hidden" href="#contenu">Aller au contenu principal</a>
<Header/>
<main id="contenu" tabindex="-1">
    <slot/>
</main>
<Footer/>
</body>
</html>

<style>
    .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 50;
        padding: 0.5rem 1.25rem;
        font-weight: 600;
        color: var(--primary-foreground);
        background-color: var(--primary);
        border-radius: var(--radius-sm);
        translate: 0 -200%;
    }

    .skip-link:focus-visible {
        translate: 0 0;
    }

    main:focus {
        outline: none;
    }
</style>
